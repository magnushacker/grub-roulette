# Copy this file to .env and fill in real values.

# Random long string used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Google Places API key ("Places API (New)" must be enabled on the project --
# this is a separate product from the legacy "Places API" and is what returns
# cuisine-specific place types like italian_restaurant/asian_restaurant).
# Get one at https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_PLACES_API_KEY=

# Google Maps JavaScript API key, used by the browser to render the map.
# This key is visible in the page's HTML source (that's normal for this API), so
# before deploying anywhere public, use a separate key from GOOGLE_PLACES_API_KEY
# and restrict it by HTTP referrer in the Cloud Console rather than by IP.
# Enable "Maps JavaScript API" on the project. Leave blank to fall back to
# GOOGLE_PLACES_API_KEY (fine for local dev, not recommended once deployed).
GOOGLE_MAPS_JS_API_KEY=

# Yelp Fusion API key.
# Get one at https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=

# Resend API key, used to send the signup verification email once
# REQUIRE_EMAIL_VERIFICATION is turned on. Get one at https://resend.com/api-keys.
# Leave blank for local dev -- the verification link is printed to the server
# console instead of emailed.
RESEND_API_KEY=

# Sender address for verification emails, e.g. "Grub Roulette <noreply@yourdomain.com>".
# Must be a domain verified in Resend, or use the sandbox onboarding@resend.dev
# sender for testing (only delivers to your own Resend account email).
EMAIL_FROM=

# Public base URL of the deployed app, used to build the link inside the
# verification email. No trailing slash.
APP_BASE_URL=http://localhost:8000

# Whether registration requires clicking an emailed verification link before
# logging in. Registration always collects an email either way. Turn this on
# once RESEND_API_KEY/EMAIL_FROM point at a verified domain.
REQUIRE_EMAIL_VERIFICATION=false

# SQLite file, relative to the project root. Leave as-is unless you know you want something else.
DATABASE_URL=sqlite:///./lunch.db

# Default search radius in meters when the user hasn't changed it.
DEFAULT_RADIUS_M=1500

# How many days a restaurant stays excluded after you log a visit there.
EXCLUDE_DAYS=7
